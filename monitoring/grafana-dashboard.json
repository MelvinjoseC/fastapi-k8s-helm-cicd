{
  "title": "Task API - Service & Business Observability",
  "uid": "taskapi-overview",
  "tags": ["taskapi", "kubernetes", "fastapi", "sre"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"taskapi\"}[5m])) by (handler)",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate (5xx %)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{job=\"taskapi\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"taskapi\"}[5m])), 0.001)",
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "id": 3,
      "title": "p50 / p95 / p99 Latency (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"taskapi\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"taskapi\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"taskapi\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Pod Count (Available vs Replicas)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{deployment=\"taskapi\"}",
          "legendFormat": "available"
        },
        {
          "expr": "kube_deployment_spec_replicas{deployment=\"taskapi\"}",
          "legendFormat": "desired"
        }
      ]
    },
    {
      "id": 5,
      "title": "Task Throughput by Priority (tasks/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(taskapi_tasks_created_total[5m])) by (priority)",
          "legendFormat": "Created: {{priority}}"
        },
        {
          "expr": "sum(rate(taskapi_tasks_completed_total[5m]))",
          "legendFormat": "Completed"
        }
      ]
    },
    {
      "id": 6,
      "title": "Redis Cache Hit Ratio (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "100 * sum(rate(taskapi_cache_operations_total{operation=\"get\",status=\"hit\"}[5m])) / clamp_min(sum(rate(taskapi_cache_operations_total{operation=\"get\"}[5m])), 0.001)",
          "legendFormat": "Hit Ratio %"
        }
      ]
    },
    {
      "id": 7,
      "title": "CPU Usage per Pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{container=\"taskapi\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Memory Usage per Pod (bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{container=\"taskapi\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Bulk Operations Throughput (ops/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "sum(rate(taskapi_bulk_operations_total[5m])) by (operation)",
          "legendFormat": "Bulk {{operation}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Active Tasks & Circuit Breaker Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "taskapi_active_tasks_count",
          "legendFormat": "Active Tasks"
        },
        {
          "expr": "taskapi_circuit_breaker_state",
          "legendFormat": "Circuit Breaker State (0=closed, 2=open)"
        }
      ]
    }
  ]
}
