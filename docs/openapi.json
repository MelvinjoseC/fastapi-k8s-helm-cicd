    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "description": "Liveness probe: process is up. Deliberately has no external calls\nso a slow DB/Redis never causes Kubernetes to kill a healthy pod.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Ready",
        "description": "Readiness probe: can this pod actually serve traffic? Checked\nseparately from liveness so Kubernetes stops routing to a pod whose\nDB connection is broken without restarting the whole container.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
